# Copy to .env.local and fill in. Never commit real values.

# HMAC key for the demo session cookie (HS256). Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# Pooled Postgres connection used by the running app (Neon: the "-pooler" host).
DATABASE_URL=postgres://user:password@localhost:5432/clearpath

# Optional: direct (unpooled) connection used by migrations and the seed script.
# Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=
